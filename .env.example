# Backend settings load the repository-root .env; copy this file to .env if needed.
# Relative paths MUST resolve from this repository root, not the current cwd.
ZB_ENV=development
ZB_API_PREFIX=/api/v1
ZB_DATABASE_URL=sqlite:///./var/zhb.db
ZB_STORAGE_DIR=./var/storage
ZB_CORS_ORIGINS=http://localhost:5173
ZB_MAX_UPLOAD_MB=50
ZB_TASK_CONCURRENCY=1

# Explicit provider; never silently fall back from a real provider to mock.
ZB_AI_PROVIDER=mock
ZB_AI_TIMEOUT_SECONDS=120
ZB_WORKFLOW_BASE_URL=
ZB_WORKFLOW_API_KEY=
ZB_MODEL_BASE_URL=
ZB_MODEL_API_KEY=
ZB_MODEL_NAME=

# Configure after installing and validating the actual OCR/converter runtime.
ZB_OCR_PROVIDER=none
ZB_LIBREOFFICE_BIN=

# Demo attribution, not production authentication.
ZB_DEMO_ACTOR_ID=demo-user
