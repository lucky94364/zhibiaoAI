        "relative_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "active_state": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "superseded",
            "disabled"
          ]
        },
        "parse_state": {
          "type": "string",
          "enum": [
            "pending",
            "processing",
            "succeeded",
            "partial",
            "failed"
          ]
        },
        "page_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
