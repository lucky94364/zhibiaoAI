        "block_id",
        "file_id",
        "parse_job_id",
        "page_index",
        "text",
        "method",
        "bbox",
        "quality"
      ],
      "additionalProperties": false
    },
    "ProjectCreate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "name",
        "context",
        "scope"
      ],
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "input_revision": {
          "type": "integer",
          "minimum": 1
