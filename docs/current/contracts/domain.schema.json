          }
        }
      },
      "required": [
        "file",
        "blocks",
        "issues"
      ],
      "additionalProperties": false
    },
    "Fact": {
      "type": "object",
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/Id"
        },
        "field_key": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {},
        "normalized_value": {},
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction_state": {
          "type": "string",
          "enum": [
            "clear",
            "absent",
            "unclear",
            "conflicting"
          ]
