    "Context": {
      "type": "object",
      "properties": {
        "bidder_name": {
          "type": "string",
          "minLength": 1
        },
        "project_leader": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "$ref": "#/$defs/Timestamp"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "consortium_members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "bidder_name",
        "project_leader",
        "deadline",
        "timezone"
      ],
      "additionalProperties": false
    },
    "AIContext": {
      "type": "object",
      "properties": {
        "bidder_name": {
          "type": "string",
          "minLength": 1
        },
        "project_leader": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "$ref": "#/$defs/Timestamp"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "consortium_members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deadline_date": {
