        "ai_provider",
        "is_simulated",
        "parser_pdf",
        "ocr",
        "word_converter",
        "storage",
        "database",
        "workflow_api"
      ],
      "additionalProperties": false
    },
    "FileRecord": {
      "type": "object",
      "properties": {
        "file_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
