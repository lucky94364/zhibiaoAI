        "file_id",
        "project_id",
        "logical_file_id",
        "version_no",
        "replaces_file_id",
        "source_kind",
        "original_name",
        "relative_path",
        "sha256",
        "active_state",
        "parse_state",
        "page_count",
        "error"
      ],
      "additionalProperties": false
    },
