      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_clause_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section_titles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "block_id": {
          "$ref": "#/$defs/Id"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "block_id",
        "quote"
      ],
      "additionalProperties": false
    },
    "SourceBlock": {
      "type": "object",
      "properties": {
        "block_id": {
          "$ref": "#/$defs/Id"
        },
        "file_id": {
          "$ref": "#/$defs/Id"
        },
        "parse_job_id": {
          "$ref": "#/$defs/Id"
        },
        "page_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
