      "required": [
        "field_key",
        "raw_value",
        "normalized_value",
        "unit",
        "extraction_state",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "Condition": {
      "type": "object",
      "properties": {
        "condition_key": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "field_key": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "gte",
            "lte",
            "in",
            "eq_context",
            "gte_context_date",
            "lte_context_date",
            "semantic",
            "unknown"
