        "state": {
          "type": "string",
          "enum": [
            "preparing",
            "reviewing",
            "ready_in_scope",
            "abandoned",
            "archived"
          ]
        },
        "current_verification_job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "project_id",
        "name",
        "context",
        "scope",
        "input_revision",
        "state",
        "current_verification_job_id",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "ProjectPatch": {
      "type": "object",
      "properties": {
        "expected_input_revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
