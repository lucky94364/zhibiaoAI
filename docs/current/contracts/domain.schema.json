      "required": [
        "expected_input_revision"
      ],
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "ai_provider": {
          "type": "string",
          "enum": [
            "mock",
            "haier_workflow",
            "internal_model"
          ]
        },
        "is_simulated": {
          "type": "boolean"
        },
        "parser_pdf": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "not_configured",
            "unknown"
          ]
        },
        "ocr": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "not_configured",
            "unknown"
          ]
        },
        "word_converter": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "not_configured",
            "unknown"
          ]
        },
        "storage": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "not_configured",
            "unknown"
          ]
        },
        "database": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "not_configured",
            "unknown"
          ]
        },
        "workflow_api": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "not_configured",
            "unknown"
          ]
        }
