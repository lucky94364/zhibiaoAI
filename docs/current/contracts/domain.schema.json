          }
        },
        "logic": {
          "$ref": "#/$defs/Logic"
        },
        "phase": {
          "type": "string",
          "enum": [
            "bid",
            "delivery",
            "unknown"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "category",
